# MongoDB Atlas connection string (required for API key rotation)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Database / collection names (optional)
MONGODB_DB=teraboxdl
MONGODB_COLLECTION=api_keys

# Admin token for /admin/keys endpoints
ADMIN_TOKEN=change-me

# teraboxdl API keys (JSON array). Used by seed.js to add keys to MongoDB.
# TERABOXDL_KEYS=[{"apiKey":"tbx_...","apiSecret":"...","label":"Account 1"}]
