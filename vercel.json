{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "api/parse.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/stats.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/track.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/privacy.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/download.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/auth/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/payment/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/history.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/dlink.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/payment/(.*)",
      "dest": "/api/payment/index.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, x-api-key"
      }
    },
    {
      "src": "/payment/(.*)",
      "dest": "/api/payment/index.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, x-api-key"
      }
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth/index.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, x-api-key"
      }
    },
    {
      "src": "/auth/(.*)",
      "dest": "/api/auth/index.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, x-api-key"
      }
    },
    {
      "src": "/parse",
      "dest": "/api/parse.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, x-api-key, x-client-type, x-client-source, Authorization"
      }
    },
    {
      "src": "/stats",
      "dest": "/api/stats.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      }
    },
    {
      "src": "/track",
      "dest": "/api/track.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      }
    },
    {
      "src": "/privacy",
      "dest": "/api/privacy.js",
      "headers": {
        "Content-Type": "text/html"
      }
    },
    {
      "src": "/download",
      "dest": "/api/download.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, x-api-key, Range"
      }
    },
    {
      "src": "/download.php",
      "dest": "/api/download.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, x-api-key, Range"
      }
    },
    {
      "src": "/webhook",
      "dest": "/api/webhook.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, x-razorpay-signature"
      }
    },
    {
      "src": "/api/history",
      "dest": "/api/history.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, x-api-key"
      }
    },
    {
      "src": "/history",
      "dest": "/api/history.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, x-api-key"
      }
    },
    {
      "src": "/api/dlink",
      "dest": "/api/dlink.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, x-api-key"
      }
    },
    {
      "src": "/dlink",
      "dest": "/api/dlink.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, x-api-key"
      }
    }
  ]
}
